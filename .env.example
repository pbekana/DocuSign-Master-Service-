# Django Configuration
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://docusign_user:docusign_password@localhost:5432/docusign_db

# DocuSign Configuration
DOCUSIGN_INTEGRATION_KEY=your_integration_key
DOCUSIGN_USER_ID=your_user_id
DOCUSIGN_PRIVATE_KEY_PATH=/path/to/private/key.pem
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com
DOCUSIGN_REQUEST_TIMEOUT=30
DOCUSIGN_DEFAULT_PAGE_SIZE=100
DOCUSIGN_MAX_RETRIES_ON_429=5
DOCUSIGN_DEFAULT_RETRY_AFTER=60

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=docusign
MINIO_SECURE=False

# External Call Retry Configuration
EXTERNAL_CALL_MAX_RETRIES=5
EXTERNAL_CALL_RETRY_DELAYS=1,2,4,8,16
EXTERNAL_CALL_JITTER=True
DLQ_PAYLOAD_MAX_BYTES=10000

# HMAC Authentication
HMAC_ENABLED=True
HMAC_SECRET_KEY_CORE=your_coordinator_hmac_secret
HMAC_SECRET_KEY_ENGINEER=your_engineer_hmac_secret
HMAC_SIGNATURE_MAX_AGE=300
HMAC_CLIENT_CONFIG=coordinator,engineer

# Logging
LOG_LEVEL=INFO

# Maintenance
RETENTION_DAYS=90
HEARTBEAT_TIMEOUT_MINUTES=10
